# Copy to .env and set CW_API_HOST before deployment.
CW_API_HOST=
CW_ALLOWED_ORIGIN=https://crisisweave.netlify.app
CW_RATE_LIMIT_PER_MINUTE=120
CW_PROMETHEUS_PORT=9090
CW_PROMETHEUS_RETENTION=15d

# Runtime hardening defaults. Raise only after measuring real load.
CW_WORKSITES_HTTP_WORKERS=32
CW_PLATFORM_HTTP_WORKERS=64
CW_HTTP_SOCKET_TIMEOUT=10
CW_WORKSITES_MEMORY_LIMIT=512m
CW_PLATFORM_MEMORY_LIMIT=768m
CW_CADDY_MEMORY_LIMIT=256m
CW_PROMETHEUS_MEMORY_LIMIT=1g
CW_BLACKBOX_MEMORY_LIMIT=256m

# Generated locally by init.sh. Keep these values only in the ignored .env file.
CW_TOKEN_PEPPER=
CW_WORKSITES_TOKEN=

# Optional override of pinned Git build contexts.
# Leave these commented to use the reviewed defaults in compose.yaml.
# CW_WORKSITES_GIT_CONTEXT=https://github.com/davidmariscalf/crisisweave-worksites.git#b3ef51e9537fe7b7d24ddef649d431923ceaab62
# CW_PLATFORM_GIT_CONTEXT=https://github.com/davidmariscalf/crisisweave-platform.git#74ce5b52a1c9eedefdff992f7080b6532415213b
