# Copy to .env, run sh init.sh, then fill every production-required value.
CW_DEPLOYMENT_ENV=development
CW_API_HOST=
CW_ALLOWED_ORIGIN=https://crisisweave.netlify.app
CW_RATE_LIMIT_PER_MINUTE=120
CW_PROMETHEUS_PORT=9090
CW_PROMETHEUS_RETENTION=15d

# Alertmanager uses the committed null receiver in development. For production,
# generate alertmanager.generated.yml and set CW_ALERTMANAGER_CONFIG accordingly.
CW_ALERTMANAGER_CONFIG=./alertmanager.dev.yml
CW_ALERT_WEBHOOK_URL=

# Production operations. go-live-check.py fails closed until these are real values.
CW_BACKUP_AGE_RECIPIENT=
CW_DATA_RETENTION_DAYS=90
CW_TOKEN_RETENTION_DAYS=30
CW_INCIDENT_RESPONSE_CONTACT=
CW_PRIVACY_CONTACT=
CW_BACKUP_OWNER=

# Runtime hardening defaults. Raise only after measuring real load.
CW_WORKSITES_HTTP_WORKERS=32
CW_PLATFORM_HTTP_WORKERS=64
CW_HTTP_SOCKET_TIMEOUT=10
CW_WORKSITES_MEMORY_LIMIT=512m
CW_PLATFORM_MEMORY_LIMIT=768m
CW_CADDY_MEMORY_LIMIT=256m
CW_PROMETHEUS_MEMORY_LIMIT=1g
CW_ALERTMANAGER_MEMORY_LIMIT=256m
CW_BLACKBOX_MEMORY_LIMIT=256m

# Generated locally by init.sh. Keep these values only in the ignored .env file.
CW_TOKEN_PEPPER=
CW_WORKSITES_TOKEN=

# Optional override of pinned Git build contexts.
# Leave these commented to use the reviewed defaults in compose.yaml.
# CW_WORKSITES_GIT_CONTEXT=https://github.com/davidmariscalf/crisisweave-worksites.git#128eaa4245cf0eaccc4c5f2d92e86a19be37888c
# CW_PLATFORM_GIT_CONTEXT=https://github.com/davidmariscalf/crisisweave-platform.git#6cfe69bad9b044174d66d63a77e1d1419aef71be
