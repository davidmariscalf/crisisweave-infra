# Replace api.example.org at deployment time. Do not put credentials here.
api.example.org {
    encode zstd gzip

    header {
        -Server
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy no-referrer
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
    }

    request_body {
        max_size 128KB
    }

    reverse_proxy crisisweave-platform:8080 {
        health_uri /healthz
        health_interval 30s
        health_timeout 3s
    }
}
