global:
  scrape_interval: 30s
  evaluation_interval: 30s

scrape_configs:
  - job_name: crisisweave-platform
    metrics_path: /metrics
    static_configs:
      - targets: ["crisisweave-platform:8080"]

  - job_name: crisisweave-blackbox
    metrics_path: /probe
    params:
      module: [http_2xx]
    static_configs:
      - targets:
          - https://crisisweave.netlify.app/health.json
          - https://api.example.org/healthz
          - https://api.example.org/readyz
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: blackbox-exporter:9115
