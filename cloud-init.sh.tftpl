#!/usr/bin/env bash
set -euo pipefail

export DEBIAN_FRONTEND=noninteractive

log() {
  printf '[crisisweave-bootstrap] %s\n' "$*"
}

log 'Installing Docker and required security tools'
apt-get update
apt-get install -y ca-certificates curl git openssl docker.io docker-compose-v2 ufw unattended-upgrades
systemctl enable --now docker

log 'Configuring automatic security updates without automatic reboots'
cat >/etc/apt/apt.conf.d/20auto-upgrades <<'EOF'
APT::Periodic::Update-Package-Lists "1";
APT::Periodic::Unattended-Upgrade "1";
EOF
cat >/etc/apt/apt.conf.d/52crisisweave-unattended-upgrades <<'EOF'
Unattended-Upgrade::Automatic-Reboot "false";
Unattended-Upgrade::Remove-Unused-Dependencies "true";
EOF
systemctl enable --now apt-daily.timer apt-daily-upgrade.timer || true

log 'Configuring host firewall'
ufw --force reset
ufw default deny incoming
ufw default allow outgoing
ufw allow 80/tcp
ufw allow 443/tcp
ufw allow 443/udp
if [ "${ssh_enabled}" = "true" ]; then
  ufw allow from "${ssh_source_cidr}" to any port 22 proto tcp
fi
ufw --force enable

install -d -m 0755 /opt/crisisweave
if [ ! -d /opt/crisisweave/infra/.git ]; then
  git clone --no-checkout https://github.com/davidmariscalf/crisisweave-infra.git /opt/crisisweave/infra
fi

git -C /opt/crisisweave/infra fetch --depth 1 origin "${infra_git_ref}"
git -C /opt/crisisweave/infra checkout --detach FETCH_HEAD

cd /opt/crisisweave/infra/deploy/stack

# Reuse the repository initializer so secret generation has one implementation.
sh init.sh

set_env_value() {
  key="$1"
  value="$2"
  tmp=".env.oci.$$"
  grep -v "^$key=" .env > "$tmp" || true
  printf '%s=%s\n' "$key" "$value" >> "$tmp"
  chmod 600 "$tmp"
  mv "$tmp" .env
}

set_env_value CW_API_HOST "${api_site}"
set_env_value CW_ALLOWED_ORIGIN "${allowed_origin}"
chmod 600 .env

log 'Building and starting CrisisWeave from the pinned infrastructure revision'
docker compose up -d --build

cat >/etc/systemd/system/crisisweave-compose.service <<'EOF'
[Unit]
Description=CrisisWeave Docker Compose stack
Requires=docker.service network-online.target
After=docker.service network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/crisisweave/infra/deploy/stack
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable crisisweave-compose.service

log 'Waiting for the stack to become ready'
for attempt in $(seq 1 60); do
  if sh verify.sh >/var/log/crisisweave-verify.log 2>&1; then
    touch /opt/crisisweave/READY
    log 'CrisisWeave is ready'
    exit 0
  fi
  sleep 5
done

log 'CrisisWeave did not become ready before bootstrap timeout'
docker compose ps || true
docker compose logs --no-color --tail=200 platform worksites caddy prometheus blackbox || true
exit 1
